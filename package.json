{
	"name": "connect-protocol",
	"version": "0.1.1",
	"description": "Browser-only Connect authentication and multi-chain wallet adapters",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "https://github.com/bchainhub/connect.js.git"
	},
	"files": [
		"dist/browser",
		"dist/**/*.d.ts",
		"test/fixtures/conformance.json",
		"docs",
		"LICENSE",
		"README.md",
		"examples/browser-only.html",
		"examples/dapp",
		"examples/nearby"
	],
	"main": "./dist/browser/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/browser/index.js"
		},
		"./package.json": "./package.json",
		"./wallet": {
			"types": "./dist/wallet/index.d.ts",
			"import": "./dist/browser/wallet.js"
		},
		"./verification": {
			"types": "./dist/verification/index.d.ts",
			"import": "./dist/browser/verification.js"
		}
	},
	"scripts": {
		"build": "node scripts/clean-legacy.mjs && tsc && node scripts/build-browser.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src && prettier --check src test scripts examples package.json tsconfig.json eslint.config.js --ignore-unknown --no-error-on-unmatched-pattern",
		"test": "npm run build && node --test test/*.test.mjs",
		"prepublishOnly": "npm run build",
		"format": "prettier --write src test scripts examples package.json tsconfig.json eslint.config.js --ignore-unknown --no-error-on-unmatched-pattern",
		"test:package": "npm run build && node scripts/package-smoke.mjs",
		"test:browser": "npm run build && node scripts/test-browser.mjs"
	},
	"devDependencies": {
		"@noble/curves": "^2.0.0",
		"@noble/hashes": "^2.0.0",
		"@playwright/test": "^1.63.0",
		"@scure/base": "^2.4.0",
		"@solana/wallet-standard-features": "^1.4.0",
		"@stellar/stellar-sdk": "^17.0.1",
		"@types/node": "^22.0.0",
		"@wallet-standard/features": "^1.1.1",
		"assert": "^2.1.0",
		"bip322-js": "^4.0.0",
		"cborg": "^4.5.8",
		"esbuild": "^0.25.0",
		"esbuild-plugins-node-modules-polyfill": "^1.8.3",
		"eslint": "^9.0.0",
		"monero-ts": "^0.11.15",
		"prettier": "^3.6.2",
		"qrcode": "^1.5.4",
		"ripple-keypairs": "^3.0.0",
		"tronweb": "^6.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.0.0",
		"viem": "^2.0.0"
	},
	"dependencies": {
		"@wallet-standard/app": "^1.1.1",
		"@wallet-standard/base": "^1.1.1",
		"zod": "^4.0.0"
	},
	"overrides": {
		"monero-ts": {
			"serialize-javascript": "^7.1.1",
			"uuid": "^11.1.1"
		}
	}
}
